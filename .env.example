# Copy this file to ".env" (same folder) and fill in. Never share or upload .env.
SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Receipt emails (leave blank to record payments without emailing).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=yourgroup@gmail.com,
# SMTP_PASSWORD=<a Gmail "App password">, not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORG_NAME=Enactus UTAS
CURRENCY=GHS
# "both" = President AND Vice President must approve. "either" = one of them is enough.
APPROVAL_MODE=both

# Name shown as "System by ..." in the app, receipts and emails (leave blank for the default).
BUILT_BY=

# The public address of this system once live (used in password reset emails).
BASE_URL=
